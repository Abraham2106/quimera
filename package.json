{
  "name": "quimera",
  "version": "0.0.0",
  "private": true,
  "description": "Toolkit local-first en TypeScript para migración con procedencia, pasaportes verificables de APIs de Costa Rica, pruebas fiscales y operación de taller",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abraham2106/quimera.git"
  },
  "homepage": "https://github.com/Abraham2106/quimera#readme",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "overrides": {
      "tinypool": "2.1.2",
      "drizzle-orm": "0.45.2"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "DATABASE_URL=${DATABASE_URL:-postgres://quimera:quimera@127.0.0.1:5432/quimera} vitest run --passWithNoTests --fileParallelism=false --maxWorkers=1",
    "test:isolation": "node scripts/test-isolation.mjs",
    "demo:verify": "node scripts/demo-verify.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "quimera": "node scripts/quimera.mjs",
    "oficios:serve": "pnpm exec tsx apps/oficios/src/server.ts",
    "test:security": "DATABASE_URL=${DATABASE_URL:-postgres://quimera:quimera@127.0.0.1:5432/quimera} vitest run --fileParallelism=false packages/data-exodus/tests/storage/fs-artifact-store.test.ts packages/data-exodus/tests/importers/fe-xml.test.ts packages/factura-ci/src/t-sec-012-loopback-only.test.ts packages/data-exodus/tests/db/postgres-qum.integration.test.ts apps/oficios/tests/db/t-sec-ofi-rls.test.ts apps/oficios/tests/db/t-saas-rls.test.ts",
    "spec:validate": "OPENSPEC_TELEMETRY=0 openspec validate --all --strict",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.39.1",
    "@fission-ai/openspec": "^2.1.1",
    "@types/node": "^22.19.1",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.39.1",
    "fast-check": "^4.3.0",
    "tsx": "^4.20.6",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^3.2.4"
  }
}