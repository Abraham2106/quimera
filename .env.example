# Conexión a PostgreSQL 16 (local o vía docker compose).
# Sin Docker: instale Postgres 16 en el host y use 127.0.0.1:5432 con usuario/db quimera.
# Con Docker: `docker compose up -d postgres` y reutilice esta URL.
DATABASE_URL=postgres://quimera:quimera@127.0.0.1:5432/quimera

# IA opcional (Clairic); deshabilitada en el baseline MVP.
QUIMERA_AI_ENABLED=false