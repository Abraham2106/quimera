# Copie a `.env` y rellene solo en entornos donde corresponda (nunca commitear secretos).

DATABASE_URL=

# API OficiOS — JWT y JWKS
OFICIOS_JWT_SECRET=
OFICIOS_JWKS_URL=
OFICIOS_JWT_ISSUER=
OFICIOS_JWT_AUDIENCE=

# Almacén de artefactos (memory | fs | s3)
OFICIOS_ARTIFACT_STORE=
OFICIOS_S3_ENDPOINT=
OFICIOS_S3_REGION=
OFICIOS_S3_BUCKET=
OFICIOS_S3_ACCESS_KEY_ID=
OFICIOS_S3_SECRET_ACCESS_KEY=

# Worker fiscal — bóveda y transporte Hacienda
FISCAL_VAULT=
FISCAL_VAULT_URL=
FISCAL_TRANSPORT=
FISCAL_TRANSPORT_URL=

# Webhooks de cobro SaaS
BILLING_WEBHOOK_SECRET=
BILLING_WEBHOOK_TOLERANCE_SECONDS=

# Telemetría (opcional)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Prueba E2E contra sandbox Hacienda (solo con credenciales reales)
HACIENDA_SANDBOX_E2E=

# Desarrollo local sin Docker (opcional)
# DATABASE_URL=postgres://quimera:quimera@127.0.0.1:5432/quimera

# IA opcional (Clairic); deshabilitada en el baseline MVP.
QUIMERA_AI_ENABLED=false